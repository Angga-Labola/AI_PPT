# Copy this file to .env and fill in values on your own computer.
# Never commit .env or paste secret values into source code.
GOOGLE_API_KEY=
# "auto" uses Vercel background jobs online and synchronous generation locally.
GENERATION_MODE=auto
GEMINI_MODEL=gemini-3.5-flash-lite
TAVILY_API_KEY=
DATABASE_URL=
# Vercel storage settings; local mode does not need these.
BLOB_STORE_ID=
# Use this only if you are configuring Blob with a read/write token instead of OIDC.
BLOB_READ_WRITE_TOKEN=
MAILJET_API_KEY=
MAILJET_API_SECRET=
# Mailjet only sends from an address verified in your Mailjet account.
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME=AI PowerPoint Generator
NOTIFICATION_EMAIL=
APP_BASE_URL=
# Required by Vercel's daily job-cleanup schedule.
CRON_SECRET=
LOG_LEVEL=INFO
